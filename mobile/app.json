{
  "expo": {
    "name": "SearchOne",
    "slug": "searchone",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "searchone",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f6f3ea"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.metinatilgan.searchone",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyTrackingDomains": [],
        "NSPrivacyCollectedDataTypes": [
          {
            "NSPrivacyCollectedDataType": "NSPrivacyCollectedDataTypeSearchHistory",
            "NSPrivacyCollectedDataTypeLinked": false,
            "NSPrivacyCollectedDataTypeTracking": false,
            "NSPrivacyCollectedDataTypePurposes": [
              "NSPrivacyCollectedDataTypePurposeAppFunctionality"
            ]
          }
        ],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": [
              "CA92.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": [
              "C617.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": [
              "35F9.1"
            ]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": [
              "E174.1"
            ]
          }
        ]
      }
    },
    "android": {
      "package": "com.searchone.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0e7c66"
      }
    },
    "extra": {
      "apiBaseUrl": "http://localhost:5173",
      "privacyPolicyUrl": "https://metinatilgan.github.io/SearchOne/privacy.html",
      "privacyChoicesUrl": "https://metinatilgan.github.io/SearchOne/privacy-choices.html",
      "termsUrl": "https://metinatilgan.github.io/SearchOne/terms.html",
      "eulaUrl": "https://metinatilgan.github.io/SearchOne/eula.html",
      "subscriptionTermsUrl": "https://metinatilgan.github.io/SearchOne/subscription-terms.html",
      "supportUrl": "https://metinatilgan.github.io/SearchOne/support.html",
      "reportIssueUrl": "https://metinatilgan.github.io/SearchOne/support.html#report",
      "apiTimeoutMs": 12000
    }
  }
}
