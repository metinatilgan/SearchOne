{
  "expo": {
    "name": "SearchOne",
    "slug": "searchone",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "searchone",
    "userInterfaceStyle": "light",
    "assetBundlePatterns": [
      "**/*"
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#f6f3ea"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.searchone.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.searchone.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0e7c66"
      }
    },
    "extra": {
      "apiBaseUrl": "http://localhost:5173",
      "privacyPolicyUrl": "https://metinatilgan.github.io/SearchOne/privacy.html",
      "privacyChoicesUrl": "https://metinatilgan.github.io/SearchOne/privacy-choices.html",
      "termsUrl": "https://metinatilgan.github.io/SearchOne/terms.html",
      "eulaUrl": "https://metinatilgan.github.io/SearchOne/eula.html",
      "subscriptionTermsUrl": "https://metinatilgan.github.io/SearchOne/subscription-terms.html",
      "apiTimeoutMs": 12000
    }
  }
}
