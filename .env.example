# Copy this file to .env and set one provider key.
# Set REQUIRE_LIVE_SEARCH=true when you want to prevent demo fallback.

SEARCH_PROVIDER=tavily
REQUIRE_LIVE_SEARCH=false

# Recommended for the MVP because it has a no-card free tier:
TAVILY_API_KEY=
TAVILY_SEARCH_DEPTH=basic
TAVILY_TOPIC=general
TAVILY_COUNTRY=turkey

# Optional alternatives:
BRAVE_SEARCH_API_KEY=

BING_SEARCH_API_KEY=
SERPAPI_API_KEY=

# Server
PORT=5173
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=30
SEARCH_TIMEOUT_MS=8000
SEARCH_COUNTRY=tr
SEARCH_LANG=tr
SEARCH_UI_LANG=tr-TR
SEARCH_SAFESEARCH=moderate
